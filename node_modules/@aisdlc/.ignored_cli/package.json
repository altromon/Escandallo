{
  "name": "@aisdlc/cli",
  "version": "1.3.0",
  "description": "Command line interface for AI-SDLC quality gates, governance, and scaffolding",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aisdlc": "./bin/aisdlc.js"
  },
  "main": "./dist/index.js",
