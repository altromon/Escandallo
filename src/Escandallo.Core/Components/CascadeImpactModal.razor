@using Microsoft.AspNetCore.Components
@namespace Escandallo.Core.Components

<div role="dialog" aria-modal="true" aria-labelledby="cascade-modal-title" class="escandallo-modal">
    <h2 id="cascade-modal-title">Confirmación de Recálculo en Cascada</h2>
    <p>Este cambio recalculará @AffectedCount escandallos activos y guardará una instantánea histórica inmutable.</p>
    <div class="modal-actions">
        <button type="button" class="touch-target-44">Confirmar y Recalcular</button>
        <button type="button" class="touch-target-44">Cancelar</button>
    </div>
</div>

@code {
    [Parameter] public int AffectedCount { get; set; } = 2;
}
