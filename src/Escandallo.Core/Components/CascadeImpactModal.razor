@using Microsoft.AspNetCore.Components
@namespace Escandallo.Core.Components

<div role="dialog" aria-modal="true" aria-labelledby="cascade-modal-title" class="escandallo-modal">
    <h2 id="cascade-modal-title">Actualización automática de tus servicios</h2>
    <p>Al actualizar el precio de este producto se recalcularán automáticamente @AffectedCount servicios que lo utilizan, conservando tu historial de precios anteriores.</p>
    <div class="modal-actions">
        <button type="button" class="touch-target-44">Guardar y actualizar servicios</button>
        <button type="button" class="touch-target-44">Cancelar</button>
    </div>
</div>

@code {
    [Parameter] public int AffectedCount { get; set; } = 2;
}
