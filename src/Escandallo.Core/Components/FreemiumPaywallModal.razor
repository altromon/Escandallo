@using Microsoft.AspNetCore.Components
@namespace Escandallo.Core.Components

<div role="dialog" aria-modal="true" aria-labelledby="paywall-modal-title" class="escandallo-modal">
    <h2 id="paywall-modal-title">Has alcanzado el límite de @ActiveEscandallosCount servicios en uso del plan gratuito</h2>
    <p>Archiva un servicio que no utilices ahora sin perder su historial o activa el Plan Pro en Stripe (14,90 EUR/mes o 149,00 EUR/año + IVA).</p>
    <div class="modal-actions">
        <button type="button" class="touch-target-44">Archivar un servicio en uso</button>
        <button type="button" class="touch-target-44">Activar Plan Pro con Stripe</button>
    </div>
</div>

@code {
    [Parameter] public int ActiveEscandallosCount { get; set; } = 2;
    [Parameter] public string SubscriptionState { get; set; } = "Plan Gratuito";
}
